@using Microsoft.AspNetCore.Identity
@using SeninMvcProjeAdi.Models
@inject UserManager<Users> UserManager

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var currentUser = User.Identity.IsAuthenticated
        ? await UserManager.GetUserAsync(User)
        : null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>ShoeStore Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
            body {
                background: #f4f6fb;
                font-family: 'Segoe UI', sans-serif;
            }

            .sidebar {
                width: 270px;
                min-height: 100vh;
                background: linear-gradient(180deg, #111827, #020617);
                position: fixed;
                top: 0;
                left: 0;
                padding: 25px 18px;
            }

            .brand-box {
                color: white;
                font-size: 25px;
                font-weight: 800;
                margin-bottom: 35px;
            }

            .sidebar a {
                color: #cbd5e1;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 13px 15px;
                border-radius: 14px;
                margin-bottom: 8px;
                transition: .2s;
                font-weight: 500;
            }

                .sidebar a:hover,
                .sidebar a.active {
                    background: white;
                    color: #111827;
                }

            .sidebar-footer {
                position: absolute;
                bottom: 25px;
                left: 18px;
                right: 18px;
            }

            .content {
                margin-left: 270px;
                padding: 30px;
            }

            .topbar {
                background: white;
                border-radius: 22px;
                padding: 20px 25px;
                box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
                margin-bottom: 30px;
            }

            .user-avatar {
                width: 42px;
                height: 42px;
                border-radius: 50%;
                background: #111827;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .stat-card,
            .table-card {
                background: white;
                border-radius: 22px;
                padding: 25px;
                box-shadow: 0 10px 30px rgba(15, 23, 42, .06);
            }

            .btn-admin {
                border-radius: 12px;
                padding: 10px 16px;
            }

            .form-control {
                border-radius: 12px;
                padding: 12px 15px;
                border: 1px solid #d1d5db;
            }

                .form-control:focus {
                    box-shadow: 0 0 0 .15rem rgba(17,24,39,.15);
                    border-color: #111827;
                }

            .btn-admin {
                border-radius: 12px;
                padding: 10px 18px;
            }
    </style>
</head>

<body>

    <aside class="sidebar">

        <div class="brand-box">
            <i class="bi bi-bag-heart"></i> ShoeStore
        </div>

        <a asp-controller="Admin" asp-action="Index"
           class="@(controller == "Admin" ? "active" : "")">
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </a>

        <a asp-controller="Category" asp-action="Index"
           class="@(controller == "Category" ? "active" : "")">
            <i class="bi bi-tags"></i>
            Kategoriler
        </a>

        <a asp-controller="Brand" asp-action="Index"
           class="@(controller == "Brand" ? "active" : "")">
            <i class="bi bi-award"></i>
            Markalar
        </a>

        <a asp-controller="Shoe" asp-action="Index"
           class="@(controller == "Shoe" ? "active" : "")">
            <i class="bi bi-bag"></i>
            Ayakkabılar
        </a>
        <a asp-controller="Sale" asp-action="Index"
           class="@(controller == "Sale" ? "active" : "")">
            <i class="bi bi-receipt"></i>
            Satışlar
        </a>
        <hr class="text-secondary" />

        <a asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i>
            Siteye Dön
        </a>

        <div class="sidebar-footer">
            <a asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i>
                Çıkış Yap
            </a>
        </div>

    </aside>

    <main class="content">

        <div class="topbar d-flex justify-content-between align-items-center">

            <div>
                <h4 class="mb-0 fw-bold">
                    @controller Yönetimi
                </h4>
                <small class="text-muted">
                    ShoeStore admin paneline hoş geldiniz
                </small>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="text-end">
                    <strong>
                        @(currentUser != null ? currentUser.FullName : "Admin")
                    </strong>
                    <br />
                    <small class="text-muted">Yönetici</small>
                </div>

                <div class="user-avatar">
                    @(currentUser != null ? currentUser.FullName.Substring(0, 1).ToUpper() : "A")
                </div>
            </div>

        </div>

        @RenderBody()

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>