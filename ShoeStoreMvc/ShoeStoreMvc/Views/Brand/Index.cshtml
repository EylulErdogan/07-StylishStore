@model List<ShoeStoreApi.Models.Brand>

@{
    Layout = "_AdminLayout";
    int count = 0;
}

<div class="table-card">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">Marka Listesi</h4>
            <small class="text-muted">Sistemde kayıtlı markalar</small>
        </div>

        <a asp-controller="Brand" asp-action="Create" class="btn btn-dark btn-admin">
            <i class="bi bi-plus-circle"></i> Yeni Marka
        </a>
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Marka Adı</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                count++;

                <tr>
                    <td>@count</td>
                    <td>@item.BrandName</td>
                    <td class="text-end">
                        <a asp-controller="Brand"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Güncelle
                        </a>

                        <a asp-controller="Brand"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Bu markayı silmek istediğinize emin misiniz?')">
                            Sil
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>