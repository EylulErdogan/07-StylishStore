@model ShoeStoreApi.Models.Brand

@{
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="table-card">

            <div class="mb-4">
                <h3 class="fw-bold">Yeni Marka Ekle</h3>
                <p class="text-muted mb-0">
                    Sisteme yeni bir marka ekleyebilirsiniz.
                </p>
            </div>

            <form method="post">

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Marka Adı
                    </label>

                    <input asp-for="BrandName"
                           class="form-control form-control-lg"
                           placeholder="Marka adını giriniz..." />

                    <span asp-validation-for="BrandName"
                          class="text-danger"></span>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary btn-admin">
                        <i class="bi bi-arrow-left"></i>
                        Geri Dön
                    </a>

                    <button type="submit"
                            class="btn btn-dark btn-admin">
                        <i class="bi bi-check-circle"></i>
                        Kaydet
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}