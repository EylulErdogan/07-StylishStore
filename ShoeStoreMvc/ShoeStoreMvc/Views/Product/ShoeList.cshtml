@model List<ShoeStoreApi.Models.Shoe>


<section class="hero-section position-relative bg-gray padding-medium">
    <div class="hero-content">
        <div class="container">
            <div class="row">
                <div class="text-center">
                    <h1 class="display-2 text-uppercase text-dark">Ürünler</h1>
                    <div class="breadcrumbs">
                        <span class="item">
                            <a href="/">Anasayfa &gt;</a>
                        </span>
                        <span class="item">Tüm Ürünler</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="shopify-grid py-2 my-2 py-md-5 my-md-5">
    <div class="container-lg">
        <div class="row">
            <main class="col-lg-12 col-md-12 col-sm-12">
                <div class="filter-shop d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div class="showing-product">
                        <p>
                            Toplam @ViewBag.TotalCount ürün listeleniyor
                        </p>
                    </div>

                    <div class="sort-by pb-3">
                        <form method="get" asp-controller="Product" asp-action="ShoeList">
                            <input type="hidden" name="search" value="@ViewBag.Search" />

                            <select name="sort"
                                    class="form-control"
                                    onchange="this.form.submit()">

                                <option value="">Varsayılan Sıralama</option>

                                <option value="name-asc" selected="@(ViewBag.Sort == "name-asc")">
                                    İsim A-Z
                                </option>

                                <option value="name-desc" selected="@(ViewBag.Sort == "name-desc")">
                                    İsim Z-A
                                </option>

                                <option value="price-asc" selected="@(ViewBag.Sort == "price-asc")">
                                    Fiyat Artan
                                </option>

                                <option value="price-desc" selected="@(ViewBag.Sort == "price-desc")">
                                    Fiyat Azalan
                                </option>

                            </select>
                        </form>
                    </div>

                    <div class="sort-by pb-3">
                        <form method="get" asp-controller="Product" asp-action="ShoeList" class="d-flex gap-2">

                            <input type="hidden" name="sort" value="@ViewBag.Sort" />

                            <input class="form-control"
                                   name="search"
                                   value="@ViewBag.Search"
                                   placeholder="Ürün veya marka ara..."
                                   type="search" />

                            <button class="btn btn-dark" type="submit">
                                Ara
                            </button>

                            <a asp-controller="Product"
                               asp-action="ShoeList"
                               class="btn btn-outline-secondary">
                                Temizle
                            </a>

                        </form>
                    </div>

                </div>

                <div class="product-content product-store d-flex justify-content-between flex-wrap">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-md-12 col-sm-12 mb-4 pe-3">
                            <div class="product-card position-relative">
                                <a href="/Product/Index/@item.Id">
                                    <div class="card-img">
                                        <img src="@item.ImageUrl" alt="product-item" class="product-image img-fluid">
                                        <!-- cart-concern -->
                                    </div>
                                    <div class="card-detail d-flex justify-content-left align-items-center mt-3">
                                        <h3 class="card-title  fs-6 fw-normal m-0">
                                            <a href="single-product.html">@item.ShoeName</a>
                                        </h3>
                                    </div>
                                        <span class="card-price fw-bold">@item.Price ₺</span>
                                </a>
                            </div>
                        </div>

                    }

                  
                </div>
            </main>

        </div>
    </div>
</div>