@model List<ShoeStoreApi.Models.Shoe>

@{
    Layout = "_AdminLayout";
    int count = 0;
}

<div class="table-card">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0">Ayakkabı Listesi</h4>
            <small class="text-muted">Sistemde kayıtlı ürünler</small>
        </div>

        <a asp-controller="Shoe" asp-action="Create" class="btn btn-dark btn-admin">
            <i class="bi bi-plus-circle"></i> Yeni Ayakkabı
        </a>
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>#</th>
                <th>Görsel</th>
                <th>Ürün Adı</th>
                <th>Marka</th>
                <th>Fiyat</th>
                <th>Stok</th>
                <th>Kategori</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                count++;

                <tr>
                    <td>@count</td>

                    <td>
                        <img src="@Url.Content(item.ImageUrl)"
                             style="width:70px;height:70px;object-fit:cover;border-radius:12px;" />
                    </td>

                    <td>@item.ShoeName</td>
                    <td>@item.BrandName</td>
                    <td>@item.Price TL</td>
                    <td>@item.Stock</td>

                    <td>
                        @if (item.Category != null)
                        {
                            @item.Category.CategoryName
                        }
                        else
                        {
                            <span class="text-muted">Kategori yok</span>
                        }
                    </td>

                    <td class="text-end">
                        <a asp-controller="Shoe"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Güncelle
                        </a>

                        <a asp-controller="Shoe"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?')">
                            Sil
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>